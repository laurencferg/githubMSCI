   "source": [
    "Write a Python program that defines a standard function to filter a list of numbers. The function should accept two arguments:\n",
    "\n",
    "A list of numbers\n",
    "A user-defined threshold value\n",
    "The function should return a new list containing only the numbers that are less than or equal to the specified threshold. Values greater than the threshold should be excluded."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "88a23c94-9996-4fe6-9e01-bbf7f3072e84",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1, 2, 3, 4, 5]\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "[1, 2, 3, 4, 5]"
      ]
     },
     "execution_count": 8,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "def filter_list(n, threshold):\n",
    "    result = []\n",
    "    for item in n:\n",
    "        if item <= threshold:\n",
    "            result.append(item)\n",
    "    print(result)\n",
    "    return result\n",
    "\n",
    "input_list = [1,9,2,8,3,7,4,6,5]\n",
    "filter_list(input_list, 5)"
   ]
  },
